rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    match /organisations/{orgId}/{folder}/{fileName} {
      allow read: if request.auth != null
        && orgId.matches('^[a-zA-Z0-9_\\-]+$')
        && folder in ['attachments', 'ai_documents', 'reports'];
      allow write: if request.auth != null
        && orgId.matches('^[a-zA-Z0-9_\\-]+$')
        && folder in ['attachments', 'ai_documents', 'reports']
        && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
